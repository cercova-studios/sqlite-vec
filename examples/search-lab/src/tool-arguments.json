      "enum": [
        "g2/1"
      ]
    },
    "node_type": {
      "type": "string"
    },
    "edge_type": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "out"
      ]
    },
    "source": {
      "type": "integer"
    },
    "target": {
      "type": "integer"
    },
