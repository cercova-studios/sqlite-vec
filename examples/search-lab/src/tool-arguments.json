{
  "describe": {},
  "search": {
    "mode": {
      "type": "string",
      "enum": [
        "lexical",
        "dense",
        "hybrid"
      ],
      "default": "hybrid"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "description": "FTS5 query syntax"
    },
